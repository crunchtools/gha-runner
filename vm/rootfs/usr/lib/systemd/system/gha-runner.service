[Unit]
Description=One ephemeral GitHub Actions job, then power off
Wants=network-online.target podman.socket var-lib-shared\x2dimages.mount
After=network-online.target podman.socket var-lib-shared\x2dimages.mount

[Service]
Type=simple
ImportCredential=gha.*
Environment=RUNNER_ALLOW_RUNASROOT=1
# systemd sets no HOME for a root service without User=; jobs (sdlc's launcher
# under set -u) read it, and the container runner always had one.
Environment=HOME=/root
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
ExecStart=/usr/libexec/runner-start.sh
# Done or failed, the VM is spent: the host boots a fresh overlay.
ExecStopPost=/usr/bin/systemctl --no-block poweroff
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
