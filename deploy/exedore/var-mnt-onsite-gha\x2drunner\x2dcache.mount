# Installed at /etc/systemd/system/var-mnt-onsite-gha\x2drunner\x2dcache.mount
# on exedore (a264).
#
# The runners' storage: a 200G sparse XFS image on the onsite backup volume,
# loop-mounted. Its size IS the hard cap -- the runners can fill this
# filesystem and never the backups around it. The backup volume is mounted
# noquota, and turning on XFS project quota would mean remounting it; this
# needs nothing from it. discard punches freed blocks back out of the image,
# so the image's real footprint tracks what the runners actually hold.
#
# To grow it: stop the pool, truncate -s <new> the image, start this unit,
# xfs_growfs /var/mnt/onsite/gha-runner-cache.
[Unit]
Description=GitHub Actions runner storage (200G loop image on onsite)
RequiresMountsFor=/var/mnt/onsite

[Mount]
What=/var/mnt/onsite/gha-runner-cache.img
Where=/var/mnt/onsite/gha-runner-cache
Type=xfs
Options=loop,discard,noatime

[Install]
WantedBy=multi-user.target
