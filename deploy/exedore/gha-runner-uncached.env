# Installed at /srv/gha-runner/config/gha-runner-uncached.env on exedore (a264),
# mode 0644. Shared by every uncached instance; each instance sets its own
# GHA_RUNNER_NAME in its unit. Holds no secret: the App key arrives through
# srv-secrets@gha-runner-uncachedN.
GHA_ORG=crunchtools
GHA_RUNNER_GROUP=exedore
GHA_APP_ID=5615080
GHA_LABELS=crunchtools-uncached
# No SDLC_CPUS / SDLC_MEMORY on purpose (Scott, a264): no per-job caps. The
# pool slice is the only limit, and under saturation the OOM killer stays
# inside it -- it kills a job, never a seat.
