# Installed at /etc/systemd/system/gha-runner-cached@.service on exedore (a264).
#
# One CACHED runner per instance: gha-runner-cached@1 .. @4. Same shape as
# gloval's gha-runner-cached.crunchtools.com.service -- read that header for
# the why of the two containers, the ephemeral registration and the missing
# NoNewPrivileges -- with three exedore differences:
#
#   One rootless user PER INSTANCE (ghrunner-cachedN), not per class. Each
#   instance has its own layer cache, and a job that escapes instance 1 must
#   not be able to write into the cache instance 2's next job builds from.
#
#   Storage lives in a 400G XFS loop image on the onsite backup volume
#   (/var/mnt/onsite/gha-runner-cache, see the .mount unit). The cap is the
#   filesystem's size, so the runners can fill it and never the backups.
#
#   gha-runner-egress.service is REQUIRED: it is the nftables owner-match that
#   stops these users' sockets reaching the host's loopback (OpenBao), the
#   seats' podman bridge and the private networks. No fence, no runner.
#
# Provision a new instance with /srv/gha-runner/bin/gha-runner-instance first;
# enabling a template instance whose user does not exist fails at User=.
[Unit]
Description=GitHub Actions runner cached%i (exedore, persistent layer cache)
Documentation=https://github.com/crunchtools/gha-runner/blob/main/deploy/exedore/README.md
Requires=srv-secrets@gha-runner-cached%i.service gha-runner-egress.service
After=srv-secrets@gha-runner-cached%i.service gha-runner-egress.service
RequiresMountsFor=/var/mnt/onsite/gha-runner-cache
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ghrunner-cached%i
Group=ghrunner-cached%i
Slice=gha-runner.slice
RuntimeDirectory=gha-runner-cached%i
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/gha-runner-cached%i
Environment=HOME=/var/mnt/onsite/gha-runner-cache/cached%i/home
WorkingDirectory=/var/mnt/onsite/gha-runner-cache/cached%i/home

# Hide every other service's /srv tree and everything else on the backup
# volume; keep our config read-only and our own instance directory writable.
TemporaryFileSystem=/var/srv:ro
BindReadOnlyPaths=/var/srv/gha-runner/config /var/srv/gha-runner/bin
TemporaryFileSystem=/var/mnt/onsite:ro
BindPaths=/var/mnt/onsite/gha-runner-cache/cached%i

Restart=always
RestartSec=5
# A day's prune of a 40G store outlasts the 90s default (a315).
TimeoutStartSec=20min

# Pinned by digest, pulled only when missing: a merged image never reaches the
# pool on its own. :main with --pull=newer did exactly that, and one bad merge
# (libssl) crash-looped every runner. A new image arrives only by promotion,
# README "Promoting a new image"; scripts/deploy-units-test.sh refuses :main.
ExecStartPre=-/usr/bin/podman rm -f gha-runner-cached%i
# The layer cache's daily prune (a315), here because this is the one moment no
# job can be running: the last container is gone and the next is not yet
# registered, so GitHub hands jobs to the other runners meanwhile.
# gha-runner-prune.timer touches /run/gha-runner-prune/requested, a root-owned
# directory this user can only read; the prune runs when that is newer than
# this runner's own stamp, which is touched first, so a failing prune is tried
# once per request, not before every job. `-` keeps a failure from holding the
# runner down. --init puts catatonit at PID 1 so a timeout's SIGTERM reaches
# the script (bash as PID 1 ignores it); --replace clears a record a SIGKILL
# left behind, which would otherwise fail every later prune on its name.
# PRUNE_KEEP spares the runner image itself where a job pulled it.
ExecStartPre=-/bin/sh -c 'req=/run/gha-runner-prune/requested; \
  stamp=/var/mnt/onsite/gha-runner-cache/cached%i/home/prune-done; \
  [ "$$req" -nt "$$stamp" ] || exit 0; touch "$$stamp"; \
  exec /usr/bin/podman run --rm --replace --init --pull=missing --name gha-runner-cached%i-prune \
  --network none --device /dev/fuse --security-opt label=disable \
  -e PRUNE_KEEP=quay.io/crunchtools/gha-runner@sha256:9f8aa398d3d49de17ce4da6b9d102d947c22e5c078596fa84b2cf6a64d591b6b \
  -v /var/mnt/onsite/gha-runner-cache/cached%i/containers:/home/podman/.local/share/containers \
  -v /srv/gha-runner/bin/gha-runner-prune:/usr/local/libexec/gha-runner-prune:ro \
  -v /srv/gha-runner/config/shared-images.list:/run/shared-images.list:ro \
  --entrypoint /bin/bash \
  quay.io/crunchtools/gha-runner@sha256:9f8aa398d3d49de17ce4da6b9d102d947c22e5c078596fa84b2cf6a64d591b6b \
  /usr/local/libexec/gha-runner-prune /run/shared-images.list'
ExecStartPre=/bin/sh -c 'install -d -m 0700 "$XDG_RUNTIME_DIR/gha-token" && \
  /usr/bin/podman run --rm --pull=missing --name gha-runner-cached%i-mint \
  --env-file /srv/gha-runner/config/gha-runner-cached.env \
  -v /run/srv-secrets/gha-runner-cached%i/gha-app.pem:/run/secrets/gha-app.pem:ro \
  --entrypoint /usr/local/bin/mint-registration-token.sh \
  quay.io/crunchtools/gha-runner@sha256:9f8aa398d3d49de17ce4da6b9d102d947c22e5c078596fa84b2cf6a64d591b6b \
  > "$XDG_RUNTIME_DIR/gha-token/regtoken" && \
  chmod 0600 "$XDG_RUNTIME_DIR/gha-token/regtoken"'

# The containers directory is pre-owned by the image's uid 1000 (host subuid
# start+999) by gha-runner-instance, so it is mounted WITHOUT :U. :U would
# chown the whole layer cache on every job start.
# unmask=ALL, not just /proc/sys. /proc/sys lets the nested netavark set its
# bridge's sysctls, which every `container:` or `services:` job's network needs
# (a273c). The rest (a472): the kernel refuses a fresh procfs in a child user
# namespace while any path of ours is masked, crun then bind-mounts THIS /proc
# into every nested container, and its PIDs stop matching its /proc -- psutil
# raises NoSuchProcess and mypy 2.4 dies with INTERNAL ERROR. Rootless, the
# unmasked paths stay owned by the host's root, so this user still cannot read
# or write them.
ExecStart=/usr/bin/podman run --rm --name gha-runner-cached%i \
  --label PODMAN_SYSTEMD_UNIT=gha-runner-cached@%i.service \
  --device /dev/fuse \
  --device /dev/net/tun \
  --security-opt label=disable \
  --security-opt unmask=ALL \
  --env-file /srv/gha-runner/config/gha-runner-cached.env \
  -e GHA_RUNNER_NAME=exedore-cached%i \
  -v /run/gha-runner-cached%i/gha-token:/run/gha:U \
  -v /var/mnt/onsite/gha-runner-cache/cached%i/containers:/home/podman/.local/share/containers \
  quay.io/crunchtools/gha-runner@sha256:9f8aa398d3d49de17ce4da6b9d102d947c22e5c078596fa84b2cf6a64d591b6b
# `-`: after an ephemeral job the container has already exited, and a failed
# stop would mark the unit failed on every job.
ExecStop=-/usr/bin/podman stop -t 90 gha-runner-cached%i
ExecStopPost=-/usr/bin/podman rm -f gha-runner-cached%i

[Install]
WantedBy=multi-user.target
