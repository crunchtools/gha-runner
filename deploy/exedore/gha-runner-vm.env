# Installed at /srv/gha-runner/config/gha-runner-vm.env on exedore (RT #1664).
# Every VM slot registers with both labels: there is one class of runner now,
# each job in a fresh VM, so "cached" and "uncached" route to the same place.
GHA_ORG=crunchtools
GHA_RUNNER_GROUP=exedore
GHA_APP_ID=5615080
GHA_VM_LABELS=crunchtools-uncached,crunchtools-cached
# The VM image the base disk is built from, by digest; gha-runner-vm-disk
# rebuilds the disk when this changes. Promoted like the container runners' pin.
GHA_VM_IMAGE=quay.io/crunchtools/gha-runner@sha256:PENDING
GHA_VM_BIB=quay.io/centos-bootc/bootc-image-builder:latest
