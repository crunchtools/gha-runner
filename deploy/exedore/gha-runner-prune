#!/bin/bash
# gha-runner-prune -- prune one cached runner's nested image store (a315).
# Installed at /srv/gha-runner/bin/gha-runner-prune. gha-runner-cached@.service
# runs it inside the runner image, with the store mounted where a job sees it,
# in the gap between two jobs: after the old container is gone and before the
# new one registers, so no job is running and none is held up. It runs at most
# once per request: gha-runner-prune.timer touches /run/gha-runner-prune/requested
# daily, and the unit prunes when that is newer than the runner's own stamp.
#
# Without it each cached store grew to 40-45G and the 200G filesystem filled
# (ENOSPC on private-repo jobs, a315). It removes:
#   - tagged images created more than PRUNE_AGE ago, except those
#     shared-images.list names (gha-images-warm keeps the same set warm);
#   - dangling images, which are the build layer cache, and
#     --mount=type=cache data;
#   - build containers a cancelled build left behind.
#
# `until` is an image's creation time, not its last use: an old base image a
# job pulls every day is removed daily and pulled again by its next job. The
# keep list holds the ones that matter.
#
# Usage: [PRUNE_KEEP="ref ..."] gha-runner-prune [shared-images.list]
set -euo pipefail

LIST=${1:-/srv/gha-runner/config/shared-images.list}
AGE=${PRUNE_AGE:-168h}
STORE=${PRUNE_STORE:-$HOME/.local/share/containers}

echo "gha-runner-prune: before $(du -sh "$STORE" 2>/dev/null | cut -f1)"

die() { echo "gha-runner-prune: $*" >&2; exit 1; }

# The keep set is image IDs, so another tag of a listed image is kept too. A
# listed image that is absent is fine; a store that cannot answer is not, and
# pruning against an incomplete keep set would throw away what it protects.
declare -A keep=()
refs=
if [ -s "$LIST" ]; then
  # grep exits 1 when the list holds only comments; 2 is a list it could not read.
  refs=$(grep -vE '^[[:space:]]*(#|$)' "$LIST") || [ $? -eq 1 ] \
    || die "cannot read $LIST; not pruning with an incomplete keep set"
else
  echo "gha-runner-prune: warning: $LIST missing or empty, keeping only PRUNE_KEEP" >&2
fi
for ref in ${PRUNE_KEEP:-}; do refs+=$'\n'$ref; done
while read -r ref; do
  [ -n "$ref" ] || continue
  rc=0
  podman image exists "$ref" || rc=$?
  case $rc in
    0) id=$(podman image inspect --format '{{.Id}}' "$ref") \
         || die "cannot inspect $ref; not pruning with an incomplete keep set"
       keep[$id]=1 ;;
    1) ;;
    *) die "cannot read the store (image exists $ref: exit $rc); not pruning" ;;
  esac
done <<<"$refs"

# Captured first, so a failed listing stops the run instead of reading as empty.
rows=$(podman images --no-trunc --filter "until=$AGE" \
  --format '{{.ID}} {{.Repository}} {{.Tag}} {{.Digest}}') \
  || die "cannot list images older than $AGE"

removed=0
while read -r id repo tag digest; do
  [ -n "$id" ] || continue
  # `images --no-trunc` prefixes the ID with sha256:, `image inspect` does not.
  id=${id#sha256:}
  [ -n "${keep[$id]:-}" ] && continue
  # No name at all is a dangling layer, left to image prune below. A name with
  # no tag was pulled by digest: it is removed by that digest.
  case $repo:$tag in
    '<none>':*) continue ;;
    *:'<none>') ref=$repo@$digest ;;
    *) ref=$repo:$tag ;;
  esac
  # By name, never by ID: removing one name needs no --force.
  if podman rmi "$ref" >/dev/null 2>&1; then
    echo "removed $ref"
    removed=$((removed + 1))
  else
    echo "gha-runner-prune: could not remove $ref" >&2
  fi
done <<<"$rows"

podman image prune -f --build-cache >/dev/null
podman system prune -f --build >/dev/null

echo "gha-runner-prune: removed $removed image name(s); after $(du -sh "$STORE" 2>/dev/null | cut -f1)"
