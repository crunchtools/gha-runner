# Installed at /etc/systemd/system/gha-runner-prune.service on exedore (a315).
# Asks every cached runner to prune its layer cache. It prunes nothing itself:
# a runner can be mid-job at any moment, so this only touches
# /run/gha-runner-prune/requested, and each gha-runner-cached@ instance prunes
# between its own jobs when that file is newer than its stamp. Root writes only
# in this unit's own root-owned runtime directory, never in a runner's home,
# where a planted symlink would aim the write. Uncached runners need none:
# their storage is wiped every job. Force one now with
# `systemctl start gha-runner-prune`.
[Unit]
Description=Ask the cached GitHub Actions runners to prune their image stores

[Service]
Type=oneshot
RuntimeDirectory=gha-runner-prune
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/touch /run/gha-runner-prune/requested
