# Installed at /etc/systemd/system/gha-runner-prune.service on exedore (a315).
# Asks every cached runner to prune its layer cache. It prunes nothing itself:
# a runner can be mid-job at any moment, so this only leaves prune-requested
# in each one's home, and gha-runner-cached@.service runs gha-runner-prune
# between that runner's jobs. Uncached runners need none: their storage is
# wiped every job. Force one now with `systemctl start gha-runner-prune`.
[Unit]
Description=Ask the cached GitHub Actions runners to prune their image stores
RequiresMountsFor=/var/mnt/onsite/gha-runner-cache

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for home in /var/mnt/onsite/gha-runner-cache/cached[0-9]/home; do \
  [ -d "$$home" ] || continue; touch "$$home/prune-requested" && echo "requested: $$home"; done'
