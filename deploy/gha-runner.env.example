# Copy to the service's config directory as gha-runner.env, mode 0640,
# root:ghrunner.
#
# Holds no secret. The GitHub App private key is a podman secret, created once
# on the host:
#
#   podman secret create gha-app-key ./app-private-key.pem
#
# The App needs Administration:write on the one repository whose runners it
# registers, and nothing else.
#
# GHA_LABELS must match the FAST_RUNNER_LABEL repository variable in the repo
# whose jobs this runner takes. Clearing that variable is the kill switch that
# sends every job back to GitHub-hosted runners with no commit.
GHA_REPO=crunchtools/trentina
GHA_APP_ID=
GHA_LABELS=crunchtools-fast
