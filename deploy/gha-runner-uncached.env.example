# Copy to the service's config directory as gha-runner-uncached.env, mode 0640,
# root:ghrunner-uncached.
#
# Holds no secret. The GitHub App private key is a podman secret, created as
# ghrunner-uncached (podman secrets are per user; each runner user holds its own copy):
#
#   podman secret create gha-app-key ./app-private-key.pem
#
# The App (gha-runner.crunchtools.com) holds one permission: Organization >
# Self-hosted runners: Read and write. Runners register to the org, in the
# GHA_RUNNER_GROUP runner group; which repositories may use them is that group's
# setting in the org, and which jobs land here is each repository's runs-on.
#
# GHA_LABELS must match the UNCACHED_RUNNER_LABEL variable in each repository
# whose jobs this runner takes. Clearing that variable is the kill switch that
# sends every job back to GitHub-hosted runners with no commit.
GHA_ORG=crunchtools
GHA_RUNNER_GROUP=gloval
# Each container appends its own id: one job per container, so names are unique.
GHA_RUNNER_NAME=gloval-uncached
GHA_APP_ID=
GHA_LABELS=crunchtools-uncached
